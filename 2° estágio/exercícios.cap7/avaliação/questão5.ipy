fname = input("Digite o nome do arquivo: ")

try:
    fhand = open(fname)
except:
    print("Arquivo não pode ser aberto:", fname)
    quit()

count = 0

for line in fhand:
    line = line.strip()
    if not line.startswith("From "):
        continue

    words = line.split()
    print(words[1])
    count = count + 1

print("There were", count, "lines in the file with From as the first word")
